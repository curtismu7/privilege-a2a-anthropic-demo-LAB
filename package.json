{
  "name": "privilege-a2a-anthropic-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Three-process A2A and MCP demo using Anthropic through PingOne Privilege",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "premain": "npm run build:web",
    "main": "tsx --env-file=.env src/main-agent/index.ts",
    "worker": "tsx --env-file=.env src/worker-agent/index.ts",
    "mcp": "tsx --env-file=.env src/mcp-server/index.ts",
    "aws-mock": "tsx --env-file=.env src/aws-agent-mock/index.ts",
    "predev": "npm run build:web",
    "dev": "concurrently -n mcp,worker,aws,main -c blue,magenta,yellow,green \"npm:mcp\" \"npm:worker\" \"npm:aws-mock\" \"npm:main\"",
    "build": "tsc && cp -R src/vendor dist/ && cp src/main-agent/jsonPaneSource.browser.js src/main-agent/jsonPaneCss.css dist/main-agent/ && npm run build:web",
    "build:web": "npm run build -w web",
    "build:guide": "node scripts/build-setup-guide.mjs",
    "test": "npm run build:web && tsx --test test/*.test.ts && npm test -w web",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.14",
    "@anthropic-ai/sdk": "^0.129.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.2.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.5",
    "marked": "18.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
